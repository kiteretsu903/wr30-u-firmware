# Applied on top of 237's defconfig/mt7981-ax3000.config by
# scripts/prepare-config.sh. The upstream seed supplies the complete MTK vendor
# driver Kconfig; this fragment limits the image to one device and the small
# user-facing package set below.

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-ubootmod=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-ubootmod="-kmod-mt7915e -kmod-mt7981-firmware -mt7981-wo-firmware -kmod-phy-aquantia -luci-app-ttyd -luci-app-package-manager -block-mount -kmod-fs-btrfs -automount -blkid -blockdev -fdisk -kmod-nls-cp437 -kmod-nls-iso8859-1 -kmod-usb2 -kmod-usb3 -kmod-usb-net-rndis -usbutils -kmod-veth -kmod-wireguard -kmod-nf-ipvs -kmod-nf-nathelper -kmod-nf-nathelper-extra"

CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-mediatek_hnat=y
# NET_MEDIATEK_HNAT depends on the kernel's legacy IP_NF_NAT symbol. The 237
# target defaults normally satisfy it through kmod-ipt-nat; keep that minimal
# compatibility module even though the userspace firewall is nftables-based.
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y

# UPnP is present in LuCI and uses the nftables implementation. Runtime is
# deliberately disabled by files/etc/uci-defaults/99-upnp-disabled.
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# Useful for inspecting the running vendor Wi-Fi stack without adding a broad
# diagnostics suite.
CONFIG_PACKAGE_iwinfo=y

# Explicitly override packages selected by 237's broad MediaTek target defaults
# or convenience config. The per-device negative list above is retained as a
# second image-composition guard.
CONFIG_PACKAGE_kmod-mt7915e=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-package-manager=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-wrtbwmon=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_dockerd=n
